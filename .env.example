# ─────────────────────────────────────────────────────────────────────────────
# FixLayer environment. Copy to .env for local development.
# Never commit real values. In production, set these in your host's secret manager.
# Optional integrations are feature flags: leave them empty and the feature is off.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL (managed Postgres in production; use a pooled URL on serverless).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fixlayer?sslmode=require"
# Optional: separate DB for tests (defaults to <DATABASE_URL db name>_test).
# DATABASE_URL_TEST=""
DATABASE_POOL_MAX=5

# Canonical origin. HTTPS in production; www/non-www and http requests 308 to this.
SITE_URL="https://www.example.com"

# 32+ random chars each:  openssl rand -base64 48
APP_SECRET=""
APP_ENCRYPTION_KEY=""
# Bearer token the scheduler sends to /api/cron:  openssl rand -hex 24
CRON_SECRET=""

# First owner account (used once by `pnpm db:seed`; change the password after sign-in).
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""
SEED_OWNER_NAME=""

# ── Media storage ──
# local = ./storage/uploads (single server / dev only). s3 = any S3-compatible store.
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""            # e.g. https://<account>.r2.cloudflarestorage.com (empty for AWS)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
MEDIA_PUBLIC_BASE_URL=""  # public CDN base for objects, e.g. https://media.example.com
MEDIA_PUBLIC_HOST=""      # hostname of the above, allowed in next/image and CSP

# ── Email ──
EMAIL_TRANSPORT="log"     # log | smtp
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="FixLayer <no-reply@example.com>"
CONTACT_INBOX=""          # where contact-form notifications go

# ── Monetization & measurement (leave empty until you have real IDs) ──
# Only after Google assigns it. Never put a placeholder here — /ads.txt is generated from it.
ADSENSE_PUBLISHER_ID=""   # ca-pub-XXXXXXXXXXXXXXXX
ADS_TXT_EXTRA_LINES=""    # other authorised sellers, separated by \n
GA4_MEASUREMENT_ID=""     # can also be set in admin → Settings → Analytics
CMP_SCRIPT_URL=""         # only for a certified third-party TCF CMP; Google's own CMP needs nothing here

# Set to 1 on staging/preview deployments to keep them out of search.
DISALLOW_ALL_CRAWLERS="0"
